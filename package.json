    "firebase": "^8.10.1",
    "firebase-functions": "^3.24.1",
    "firebase-tools": "^13.35.1",
    "firebaseui": "^4.8.1",
    "history": "^4.10.1",
    "jest": "^30.3.0",
    "lodash": "^4.18.1",
    "material-ui": "^0.20.2",
    "mdbreact": "5.2.0",
    "mockdate": "^3.0.5",
    "moment": "^2.30.1",
    "sass": "^1.93.2",
    "prop-types": "^15.8.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
